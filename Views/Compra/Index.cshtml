@model IEnumerable<SupermercadoCrud.Models.Compra>

@{
    ViewData["Title"] = "Index";
}

<h1>Lista de Compras</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Cadastrar</a>
</p>
<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>
                Data da Compra
            </th>
            <th>
                Valor Total
            </th>
            <th>
                Pagamento
            </th>
            <th>
               Cliente
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DataCompra)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ValorTotal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TipoPagamento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CodigoClienteNavigation.Nome)
            </td>
            <td>
                    <a class="btn btn-outline-success" asp-action="Edit" asp-route-id="@item.CodigoCompra">Editar</a>
                    <a class="btn btn-outline-warning" asp-action="Details" asp-route-id="@item.CodigoCompra">Detalhes</a>
                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.CodigoCompra">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
